---
import site from '@/config/site.json';
import Calculator from '@/components/calculator/Calculator.astro';
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import AdSlot from '@theme/components/AdSlot.astro';
import Faq from '@theme/components/Faq.astro';
import {
  absoluteUrl,
  getEntry,
  localeStaticPaths,
  localizedUrl,
  useTranslations,
  type Locale,
} from '@theme/i18n/utils';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const path = localizedUrl(locale, '/creatine-hcl-calculator');
const pageUrl = absoluteUrl(site.url, path);
const pageName = 'Creatine HCl Dosage Calculator';

/*
 * All visible copy comes from the i18n bundles.
 *
 * It used to be hardcoded English here, which meant /ar and /es served an
 * Arabic or Spanish <title> over an entirely English page — the exact mismatch
 * that made the by-weight page the site's best-ranked URL and its worst
 * converting one.
 */
const keyFacts = getEntry<string[]>(locale, 'pages.hcl.facts') ?? [];
const tableHeaders = getEntry<string[]>(locale, 'pages.hcl.tableHeaders') ?? [];
const comparisonRows = getEntry<[string, string, string][]>(locale, 'pages.hcl.rows') ?? [];

/*
 * The blog is English-only, so its cards dead-end for an ar/es reader. Those
 * locales get the sibling calculators, which do exist in their language.
 */
const showBlogLinks = locale === 'en';

const siblingTools = [
  { href: '/', key: 'nav.home' },
  { href: '/creatine-dosage-by-weight', key: 'nav.byWeight' },
  { href: '/creatine-water-calculator', key: 'nav.water' },
];

const faqItems = getEntry<{ question: string; answer: string }[]>(locale, 'pages.hcl.faq') ?? [];

const furtherReading = [
  {
    slug: 'creatine-hcl-vs-monohydrate',
    title: 'Creatine HCl vs Monohydrate',
    desc: 'A full comparison of both forms — dosage, absorption, cost, and which suits your goals.',
  },
  {
    slug: 'creatine-monohydrate-side-effects',
    title: 'Creatine Side Effects: Real vs Myths',
    desc: 'Separating fact from fiction on kidney damage, hair loss, bloating, and more.',
  },
  {
    slug: 'best-time-to-take-creatine',
    title: 'Best Time to Take Creatine',
    desc: 'Does creatine timing actually matter? The research on pre vs post-workout dosing.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('calculator.title'),
      item: absoluteUrl(site.url, localizedUrl(locale, '/')),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: pageName,
      item: pageUrl,
    },
  ],
};

// WebApplication, not SoftwareApplication: nothing is installed and it runs in
// the browser, so the narrower type is the accurate one.
const appSchema = {
  '@type': 'WebApplication',
  name: t('pages.hcl.title'),
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any (web browser)',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  url: pageUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: t('pages.hcl.description'),
};

// FAQPage is only valid with at least one question — never emit an empty graph.
const faqSchema =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const schemas = [breadcrumbSchema, appSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  locale={locale}
  title={t('pages.hcl.title')}
  description={t('pages.hcl.description')}
  canonicalPath={path}
  schemas={schemas}
>
  <section class="mb-10 text-center">
    <h1 class="mb-4 text-4xl font-extrabold text-[var(--text-primary)] md:text-5xl">
      {t('pages.hcl.h1')}
    </h1>
    <p class="mx-auto max-w-2xl text-lg text-[var(--text-secondary)]">
      {t('pages.hcl.intro')}
    </p>
  </section>

  <div class="mb-8 flex flex-col gap-8 lg:flex-row">
    <div class="flex-1 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-card)] p-6 shadow-sm md:p-8">
      <Calculator locale={locale} defaultCreatineType="hcl" />
    </div>

    <aside class="shrink-0 space-y-5 lg:w-72">
      <div class="rounded-2xl border border-[var(--tint-brand-border)] bg-[var(--tint-brand-bg)] p-5">
        <p class="mb-3 font-bold text-[var(--tint-brand-ink)]">🔬 {t('pages.hcl.factsTitle')}</p>
        <ul class="space-y-2 text-sm text-[var(--accent)]">
          {
            keyFacts.map((fact) => (
              <li class="flex gap-2">
                <span aria-hidden="true">✓</span>
                <span>{fact}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-card)] p-5 text-sm">
        <p class="mb-3 font-bold text-[var(--text-primary)]">{t('pages.hcl.compareTitle')}</p>
        <a
          href={localizedUrl(locale, '/')}
          class="mb-2 block font-medium text-[var(--accent)] hover:underline"
        >
          ← {t('pages.hcl.backToMain')}
        </a>
        <a
          href={localizedUrl(locale, '/creatine-dosage-by-weight')}
          class="block font-medium text-[var(--accent)] hover:underline"
        >
          {t('pages.hcl.toByWeight')} →
        </a>
      </div>
    </aside>
  </div>

  <AdSlot placement="calculator-hcl-below-widget" />

  <section class="mb-12">
    <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)]">
      {t('pages.hcl.whyHeading')}
    </h2>
    <p class="mb-3 text-[var(--text-secondary)]">{t('pages.hcl.whyP1')}</p>
    <p class="mb-3 text-[var(--text-secondary)]">{t('pages.hcl.whyP2')}</p>
    <p class="text-[var(--text-secondary)]">{t('pages.hcl.whyP3')}</p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)]">
      {t('pages.hcl.tableHeading')}
    </h2>
    <div class="overflow-x-auto rounded-xl border border-[var(--border-subtle)]">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-brand-600 text-white">
            {
              tableHeaders.map((header) => (
                <th scope="col" class="p-3 text-start font-semibold">
                  {header}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            comparisonRows.map(([factor, mono, hcl], i) => (
              <tr class:list={[i % 2 === 0 ? 'bg-[var(--surface-card)]' : 'bg-[var(--surface-sunken)]']}>
                <th
                  scope="row"
                  class="border-b border-[var(--border-subtle)] p-3 text-start font-medium text-[var(--text-secondary)]"
                >
                  {factor}
                </th>
                <td class="border-b border-[var(--border-subtle)] p-3 text-[var(--text-secondary)]">{mono}</td>
                <td class="border-b border-[var(--border-subtle)] p-3 font-medium text-[var(--accent)]">{hcl}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <Faq title={t('faq.title')} items={faqItems} />

  <section class="mt-8">
    <h2 class="mb-6 text-2xl font-bold text-[var(--text-primary)]">{t('pages.hcl.moreHeading')}</h2>
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        showBlogLinks
          ? furtherReading.map((article) => (
              <li>
                <a
                  href={localizedUrl(locale, `/blog/${article.slug}`)}
                  class="group block h-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-card)] p-5 transition-all hover:border-[var(--tint-brand-border)] hover:shadow-md"
                >
                  <h3 class="mb-2 font-bold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">
                    {article.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{article.desc}</p>
                  <span class="mt-3 inline-block text-sm font-medium text-[var(--accent)]">
                    {t('common.readArticle')} →
                  </span>
                </a>
              </li>
            ))
          : siblingTools.map((tool) => (
              <li>
                <a
                  href={localizedUrl(locale, tool.href)}
                  class="group block h-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-card)] p-5 transition-all hover:border-[var(--tint-brand-border)] hover:shadow-md"
                >
                  <h3 class="mb-2 font-bold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">
                    {t(tool.key)}
                  </h3>
                </a>
              </li>
            ))
      }
    </ul>
  </section>
</BaseLayout>
