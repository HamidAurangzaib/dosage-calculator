---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import { localeStaticPaths, localizedUrl, useTranslations, type Locale } from '@theme/i18n/utils';
import site from '@/config/site.json';
import { getCollection } from 'astro:content';

/**
 * Authorship and review process.
 *
 * Deliberately describes the process rather than inventing named authors with
 * invented credentials — fabricated bylines on health content are exactly the
 * signal E-E-A-T is meant to detect. If a named, credentialed reviewer is
 * engaged, their real details belong in the "Named review" section below.
 */
export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const path = localizedUrl(locale, '/editorial-team');

const posts = await getCollection('blog', ({ data }) => !data.draft);
const reviewed = posts.filter((post) => post.data.reviewedBy).length;

const title = 'Editorial Team & Review Process — CreatineCalc';
const description =
  'Who writes CreatineCalc, how every dosage figure is sourced and checked, and how to report a correction.';

// The AboutPage node comes from `pageType="about"` below — SeoHead builds it
// once with a stable @id and a reference to the shared Organization, so a
// second copy here would be a conflicting definition of the same page entity.

const principles = [
  {
    title: 'Every dosage figure traces to a citation',
    body: 'No number appears on this site without a published source behind it. The calculator formulas come from the ISSN position stand; article claims carry their own reference lists.',
  },
  {
    title: 'Sources are primary, not secondary',
    body: 'Claims are checked against the original study or position stand rather than another article summarising it. Where the research is contested, the article says so instead of picking a side.',
  },
  {
    title: 'Corrections are made, not buried',
    body: 'An error gets fixed as soon as it is confirmed, and the page shows its updated date. Accuracy takes priority over preserving what was already published.',
  },
  {
    title: 'No commercial influence',
    body: 'The site is funded by display advertising, served by a third party with no connection to what gets published. Nothing is earned from supplement sales, affiliate links or sponsorship, and no brand has ever reviewed, funded or approved anything here. If an advert beside an article promotes a product, that is not an endorsement — it is not chosen by us and carries no influence over the dosage figures or the research cited.',
  },
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={path}
  pageType="about"
>
  <div class="mx-auto max-w-4xl">
    <h1 class="mb-3 text-4xl font-extrabold text-[var(--text-primary)]">
      Editorial Team &amp; Review Process
    </h1>
    <p class="mb-10 text-lg leading-relaxed text-[var(--text-secondary)]">
      Creatine dosage is health information, so who wrote it and how it was checked matters as much
      as the number itself. This page states both plainly.
    </p>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)]">Who writes this site</h2>
      <div class="surface-card p-6">
        <div class="flex items-start gap-4">
          <span
            aria-hidden="true"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--accent)] text-lg font-bold text-white"
            >CC</span
          >
          <div>
            <p class="font-semibold text-[var(--text-primary)]">CreatineCalc Research Team</p>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
              Articles and calculator documentation are researched and written in-house, then
              cross-checked against the primary sports-nutrition literature before publication.
              Content is published under a team byline rather than individual names.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {reviewed} of {posts.length} published articles are additionally verified line-by-line against
              the ISSN Position Stand on Creatine Supplementation, and say so in their header.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)]">How an article is produced</h2>
      <ol class="space-y-4">
        {
          [
            'A topic is chosen from questions readers actually ask, not from keyword volume alone.',
            'Primary sources are gathered first — position stands, meta-analyses and controlled trials.',
            'The draft is written from those sources, with every dosage figure tied to a specific citation.',
            'Claims are re-checked against the source material, and anything that cannot be supported is cut.',
            'The reference list and review note are published with the article so readers can verify it.',
          ].map((step, index) => (
            <li class="surface-card flex gap-4 p-5">
              <span
                aria-hidden="true"
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[var(--accent-soft)] font-bold text-[var(--accent)]"
              >
                {index + 1}
              </span>
              <p class="text-[var(--text-secondary)]">{step}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)]">Our editorial principles</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          principles.map((item) => (
            <div class="surface-card p-5">
              <h3 class="mb-1.5 font-semibold text-[var(--text-primary)]">{item.title}</h3>
              <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{item.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)]">Medical review status</h2>
      <div
        class="rounded-2xl border border-[var(--tint-caution-border)] bg-[var(--tint-caution-bg)] p-6"
      >
        <p class="mb-2 font-semibold text-[var(--tint-caution-ink)]">
          This content is not reviewed by a licensed clinician.
        </p>
        <p class="text-sm leading-relaxed text-[var(--tint-caution-ink)]">
          Articles are researched against peer-reviewed literature, but no registered dietitian or
          physician currently signs off on them. Nothing here is medical advice, and it is not a
          substitute for consulting a qualified professional about your own circumstances —
          particularly with pre-existing kidney conditions, during pregnancy or breastfeeding, or
          for anyone under 18.
        </p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)]">Report a correction</h2>
      <p class="mb-5 leading-relaxed text-[var(--text-secondary)]">
        If a figure, citation or claim on this site looks wrong, tell us and it gets checked. Point
        to the page and, where possible, the source you believe is correct.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={localizedUrl(locale, '/contact')} class="btn-primary">Contact the team</a>
        <a href={`mailto:${site.contactEmail}`} class="btn-secondary">{site.contactEmail}</a>
      </div>
    </section>
  </div>
</BaseLayout>
