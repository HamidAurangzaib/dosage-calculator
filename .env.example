# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# --- Contact form (src/pages/api/contact.ts) --------------------------------
# The form posts to /api/contact, which relays the message over SMTP.
# Without SMTP_USER and SMTP_PASS the endpoint returns a generic 500 and logs
# the misconfiguration, so these must be set in the Vercel project too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where contact submissions are delivered. Defaults to SMTP_USER if unset.
CONTACT_EMAIL=

# --- Push notifications -----------------------------------------------------
# OneSignal REST API Key (Settings → Keys & IDs in the OneSignal dashboard).
# Used by scripts/send-notification.js to send push notifications.
# The public app ID lives in src/config/site.json, not here.
ONESIGNAL_REST_API_KEY=
