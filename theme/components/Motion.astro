---
/**
 * Scroll-reveal + scroll progress.
 *
 * Deliberately no animation library. An IntersectionObserver stamps
 * `data-revealed` and CSS does the rest — which keeps this at a few hundred
 * bytes, off the main thread, and trivially reduced-motion safe.
 */
---

<!-- Scroll progress. Transform-only, so it never triggers layout. -->
<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-0.5 origin-left scale-x-0 bg-gradient-to-r from-brand-500 to-brand-600"
  data-scroll-progress
>
</div>

<script>
  // Marking the document as JS-capable is what allows CSS to hide pre-reveal
  // content. Without it, everything stays visible — no blank page if this fails.
  document.documentElement.classList.add('js');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (reduceMotion) {
    targets.forEach((el) => el.setAttribute('data-revealed', ''));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;

          // Stagger siblings within a group rather than the whole page, so a
          // long section never accumulates a multi-second delay.
          const group = el.closest('[data-reveal-group]');
          if (group) {
            const peers = [...group.querySelectorAll('[data-reveal]')];
            const index = peers.indexOf(el);
            el.style.setProperty('--reveal-delay', `${Math.min(index, 6) * 70}ms`);
          }

          el.setAttribute('data-revealed', '');
          observer.unobserve(el);
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );

    targets.forEach((el) => observer.observe(el));
  }

  // Scroll progress
  const bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
  if (bar && !reduceMotion) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // Magnetic buttons — the cursor tugs the label a few pixels. Pointer-type
  // guarded so it never fires on touch, and skipped under reduced motion.
  if (!reduceMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      const STRENGTH = 0.22;
      el.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';

      el.addEventListener('pointermove', (event) => {
        const rect = el.getBoundingClientRect();
        const dx = event.clientX - (rect.left + rect.width / 2);
        const dy = event.clientY - (rect.top + rect.height / 2);
        el.style.transform = `translate(${dx * STRENGTH}px, ${dy * STRENGTH}px)`;
      });

      el.addEventListener('pointerleave', () => {
        el.style.transform = '';
      });
    });
  }
</script>
