---
import site from '@/config/site.json';
import LanguageSwitcher from '@theme/components/LanguageSwitcher.astro';
import SocialLinks from '@theme/components/SocialLinks.astro';
import { localizedUrl, useTranslations, type Locale } from '@theme/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const columns = site.footer.columns.map((column) => ({
  title: t(column.titleKey),
  links: column.links.map((link) => ({
    label: t(link.key),
    href: localizedUrl(locale, link.href),
  })),
}));

const year = new Date().getFullYear();
---

<footer class="mt-16 bg-gray-900 text-gray-300">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 2xl:max-w-7xl">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <p class="mb-2 flex items-center gap-2 text-lg font-extrabold text-white">
          <img
            src={site.logo}
            alt={`${t('site.title')} logo`}
            width="32"
            height="32"
            loading="lazy"
            class="rounded-full bg-white"
          />
          <span>{t('site.title')}</span>
        </p>
        <p class="max-w-sm text-sm text-gray-400">{t('footer.tagline')}</p>

        <div class="mt-6">
          <SocialLinks locale={locale} />
        </div>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <p class="mb-3 font-semibold text-white">{column.title}</p>
            <ul class="space-y-2 text-sm">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="transition-colors hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-8 flex flex-col gap-4 border-t border-gray-700 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-2 text-xs text-gray-500 sm:flex-row sm:items-center sm:gap-4">
        <p>© {year} {t('site.title')}. {t('footer.rights')}</p>
        <p>{t('footer.disclaimer')}</p>
      </div>
      <LanguageSwitcher locale={locale} class="sm:shrink-0" />
    </div>
  </div>
</footer>
