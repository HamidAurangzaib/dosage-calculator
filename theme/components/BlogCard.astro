---
import { useTranslations, type Locale } from '@theme/i18n/utils';

interface Props {
  locale: Locale;
  href: string;
  title: string;
  description: string;
  image: string;
  imageAlt?: string;
  category?: string;
  date: Date;
  /** The first card in the list carries the LCP image; the rest lazy-load. */
  eager?: boolean;
}

const {
  locale,
  href,
  title,
  description,
  image,
  imageAlt,
  category,
  date,
  eager = false,
} = Astro.props;

const t = useTranslations(locale);
const formatted = date.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="surface-card-interactive group flex flex-col overflow-hidden">
  <a href={href} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt ?? ''}
      width="1200"
      height="630"
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="aspect-[1200/630] w-full bg-[var(--surface-sunken)] object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </a>

  <div class="flex flex-1 flex-col p-6">
    {
      category && (
        <span class="mb-2 inline-flex w-fit rounded-full bg-[var(--tint-brand-bg)] px-2.5 py-1 text-xs font-semibold text-[var(--accent)]">
          {category}
        </span>
      )
    }

    <h2 class="mb-2 text-lg leading-snug font-bold text-[var(--text-primary)]">
      <a href={href} class="transition-colors group-hover:text-[var(--accent)]">
        {title}
      </a>
    </h2>

    <p class="line-clamp-3 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">{description}</p>

    <div class="mt-5 flex items-center justify-between border-t border-[var(--border-subtle)] pt-4">
      <time datetime={date.toISOString()} class="text-xs text-[var(--text-muted)]">{formatted}</time>
      <span class="text-sm font-semibold text-[var(--accent)] group-hover:text-[var(--accent)]">
        {t('common.readMore')} →
      </span>
    </div>
  </div>
</article>
