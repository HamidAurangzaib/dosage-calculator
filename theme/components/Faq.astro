---
import type { FaqEntry } from '@theme/i18n/utils';

interface Props {
  title: string;
  items: FaqEntry[];
  class?: string;
}

const { title, items, class: className = '' } = Astro.props;

// Rows authored with `display: false` are withheld from both the UI and the
// FAQPage schema; callers pass the already-filtered list from getFaq().
const visible = items.filter((item) => item.display !== false);
---

{
  visible.length > 0 && (
    <section class={`mb-12 ${className}`} aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="mb-6 text-2xl font-bold text-[var(--text-primary)]">
        {title}
      </h2>

      <div class="space-y-4">
        {visible.map((item) => (
          <details class="surface-card group px-5 py-4 transition-colors open:border-[var(--tint-brand-border)] hover:border-[var(--tint-brand-border)]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-[var(--text-primary)]">
              <span>{item.question}</span>
              <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--tint-brand-bg)] text-[var(--accent)] transition-all duration-200 group-open:rotate-45 group-open:bg-brand-600 group-open:text-white"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"></path>
                </svg>
              </span>
            </summary>
            <p class="mt-3 border-t border-[var(--border-subtle)] pt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  )
}
