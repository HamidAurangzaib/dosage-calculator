---
import site from '@/config/site.json';
import LanguageSwitcher from '@theme/components/LanguageSwitcher.astro';
import ThemeToggle from '@theme/components/ThemeToggle.astro';
import { localizedUrl, useTranslations, type Locale } from '@theme/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const home = localizedUrl(locale, '/');
const navLinks = site.header.nav.map((item) => ({
  label: t(item.key),
  href: localizedUrl(locale, item.href),
}));

const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => current === href.replace(/\/$/, '');
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border-subtle)] bg-[var(--surface-page)]/80 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8 2xl:max-w-7xl">
    <a
      href={home}
      class="group flex items-center gap-2.5 text-xl font-extrabold text-[var(--text-primary)]"
      data-mobile-close
    >
      <img
        src={site.logo}
        alt={`${t('site.title')} logo`}
        width="36"
        height="36"
        class="rounded-full ring-1 ring-[var(--border-subtle)] transition-transform duration-300 group-hover:scale-105"
      />
      <span>{t('site.title')}</span>
    </a>

    <!--
      Active state is a pill that sits behind the label rather than a colour
      change alone, so the current page reads at a glance.
    -->
    <nav
      aria-label="Primary"
      class="hidden items-center gap-1 text-sm font-medium lg:flex"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 transition-colors duration-200',
              isCurrent(link.href)
                ? 'bg-[var(--accent-soft)] font-semibold text-[var(--accent)]'
                : 'text-[var(--text-secondary)] hover:bg-[var(--surface-sunken)] hover:text-[var(--text-primary)]',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle locale={locale} />
      <!-- The full-name select is too wide for a phone header; it moves into
           the mobile panel below rather than crowding the logo. -->
      <LanguageSwitcher locale={locale} class="hidden sm:block" />

      <button
        type="button"
        id="mobile-menu-toggle"
        class="btn-ghost !px-2 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('common.openMenu')}
        data-label-open={t('common.openMenu')}
        data-label-close={t('common.closeMenu')}
      >
        <svg
          data-icon="open"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          data-icon="close"
          class="hidden h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile overlay -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 z-40 hidden bg-slate-900/50 backdrop-blur-sm lg:hidden"
    aria-hidden="true"
    data-mobile-overlay
  >
  </div>

  <!-- Mobile panel -->
  <div
    id="mobile-menu"
    class="fixed inset-y-0 end-0 z-50 hidden w-72 max-w-[85vw] flex-col border-s border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-2xl lg:hidden"
    aria-hidden="true"
    aria-label="Mobile"
  >
    <div class="flex h-16 items-center justify-between border-b border-[var(--border-subtle)] px-4">
      <span class="text-base font-extrabold text-[var(--accent)]">{t('site.title')}</span>
      <button
        type="button"
        id="mobile-menu-close"
        class="btn-ghost !px-2"
        aria-label={t('common.closeMenu')}
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile primary" class="flex flex-col gap-1 overflow-y-auto p-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
              isCurrent(link.href)
                ? 'bg-[var(--accent-soft)] font-semibold text-[var(--accent)]'
                : 'text-[var(--text-secondary)] hover:bg-[var(--surface-sunken)] hover:text-[var(--text-primary)]',
            ]}
            data-mobile-close
          >
            {link.label}
          </a>
        ))
      }

      <div class="mt-4 border-t border-[var(--border-subtle)] pt-4 sm:hidden">
        <LanguageSwitcher locale={locale} />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const panel = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-menu-overlay');
  const closeButton = document.getElementById('mobile-menu-close');

  if (toggle && panel && overlay) {
    const openIcon = toggle.querySelector<SVGElement>('[data-icon="open"]');
    const closeIcon = toggle.querySelector<SVGElement>('[data-icon="close"]');
    const labelOpen = toggle.dataset.labelOpen ?? 'Open menu';
    const labelClose = toggle.dataset.labelClose ?? 'Close menu';

    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      panel.classList.toggle('flex', open);
      overlay.classList.toggle('hidden', !open);

      panel.setAttribute('aria-hidden', String(!open));
      overlay.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);

      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);

      // Lock the page behind the panel so the body doesn't scroll under it.
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) closeButton?.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    closeButton?.addEventListener('click', () => setOpen(false));
    overlay.addEventListener('click', () => setOpen(false));

    // Any navigation out of the panel (including the logo) closes it, so the
    // lock can never survive a client-side back/forward into a cached page.
    document.querySelectorAll('[data-mobile-close]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
