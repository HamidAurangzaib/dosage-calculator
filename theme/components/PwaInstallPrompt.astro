---
import { useTranslations, type Locale } from '@theme/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  id="pwa-install-prompt"
  role="dialog"
  aria-labelledby="pwa-install-title"
  aria-hidden="true"
  class="fixed inset-x-4 bottom-4 z-[55] hidden sm:inset-x-auto sm:end-4 sm:max-w-sm"
>
  <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-card)] p-5 shadow-lg">
    <div class="mb-3 flex items-start gap-3">
      <img
        src="/icon-192.png"
        alt=""
        width="44"
        height="44"
        loading="lazy"
        class="shrink-0 rounded-xl"
      />
      <div class="min-w-0 flex-1">
        <p id="pwa-install-title" class="text-sm font-semibold text-[var(--text-primary)]">
          {t('pwa.title')}
        </p>
        <p id="pwa-install-body" class="mt-0.5 text-sm leading-snug text-[var(--text-secondary)]">
          {t('pwa.body')}
        </p>
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <button
        type="button"
        id="pwa-install-dismiss"
        class="px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
      >
        {t('pwa.dismiss')}
      </button>
      <button
        type="button"
        id="pwa-install-accept"
        class="rounded-lg bg-brand-600 px-4 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        {t('pwa.install')}
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ iosBody: t('pwa.bodyIos') }}>
  (() => {
    const DISMISS_KEY = 'cc-pwa-install-dismissed';
    const DISMISS_DAYS = 14;
    const SHOW_DELAY_MS = 20_000;

    const root = document.getElementById('pwa-install-prompt');
    const accept = document.getElementById('pwa-install-accept');
    const dismiss = document.getElementById('pwa-install-dismiss');
    const body = document.getElementById('pwa-install-body');
    if (!root || !accept || !dismiss || !body) return;

    // Registered here rather than by the push SDK, so the app stays installable
    // even for visitors who never opt into notifications.
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/OneSignalSDKWorker.js').catch(() => {
        /* A registration may already exist via OneSignal — harmless. */
      });
    }

    const standalone =
      window.matchMedia('(display-mode: standalone)').matches ||
      window.navigator.standalone === true;
    if (standalone) return;

    const dismissedAt = Number(localStorage.getItem(DISMISS_KEY) || 0);
    if (dismissedAt && Date.now() - dismissedAt < DISMISS_DAYS * 86_400_000) return;

    let deferredPrompt = null;

    const show = () => {
      root.classList.remove('hidden');
      root.setAttribute('aria-hidden', 'false');
    };

    const hide = () => {
      root.classList.add('hidden');
      root.setAttribute('aria-hidden', 'true');
    };

    const ua = window.navigator.userAgent.toLowerCase();
    const isIOS = /iphone|ipad|ipod/.test(ua) && !window.MSStream;
    const isSafari = /safari/.test(ua) && !/crios|fxios|edgios/.test(ua);

    if (isIOS && isSafari) {
      // iOS Safari never fires beforeinstallprompt, so show the manual steps.
      body.textContent = iosBody;
      accept.classList.add('hidden');
      setTimeout(show, SHOW_DELAY_MS);
    } else {
      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        deferredPrompt = event;
        setTimeout(show, SHOW_DELAY_MS);
      });
    }

    accept.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      await deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
      hide();
    });

    dismiss.addEventListener('click', () => {
      localStorage.setItem(DISMISS_KEY, String(Date.now()));
      hide();
    });
  })();
</script>
