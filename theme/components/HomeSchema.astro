---
import site from '@/config/site.json';
import JsonLd from '@theme/components/JsonLd.astro';
import { absoluteUrl, localizedUrl, useTranslations, type FaqEntry, type Locale } from '@theme/i18n/utils';

interface Props {
  locale: Locale;
  faqItems?: FaqEntry[];
}

const { locale, faqItems = [] } = Astro.props;
const t = useTranslations(locale);

const homeUrl = absoluteUrl(site.url, localizedUrl(locale, '/'));

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t('site.title'),
  url: site.url,
  description: t('meta.description'),
  inLanguage: locale,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${homeUrl}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// FAQPage is emitted only when there are visible FAQs — an empty mainEntity is
// a schema validation error, not a harmless no-op.
const faqSchema =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: t('calculator.title'),
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  url: homeUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: t('meta.description'),
};
---

<JsonLd schema={websiteSchema} />
<JsonLd schema={softwareSchema} />
{faqSchema && <JsonLd schema={faqSchema} />}
