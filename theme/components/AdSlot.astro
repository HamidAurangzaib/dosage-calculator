---
/**
 * A single display-ad unit, isolated in a sandboxed iframe.
 *
 * WHY THE SANDBOX IS NOT OPTIONAL
 *
 * The network's invoke.js does not only draw a banner. Loaded directly into the
 * page it also pulls a second, obfuscated script that:
 *
 *   - calls history.pushState() to plant a duplicate history entry,
 *   - listens for popstate, and
 *   - on the user's BACK button, calls location.replace() to send them to an
 *     advertiser URL instead of back to where they came from.
 *
 * That was verified in a real browser: pressing Back navigated the tab to
 * kettledroopingcontinuation.com rather than the previous page. It is a
 * back-button hijack, it is an "abusive experience" under Chrome's own policy,
 * and on a health site it is not a trade worth making.
 *
 * Rendering the tag inside `srcdoc` with `sandbox="allow-scripts"` gives the ad
 * an opaque origin of its own. The banner still loads and still records its
 * impression, but the script can no longer see the parent document, cannot
 * touch the top-level history, and cannot navigate the tab: `allow-top-navigation`
 * is deliberately absent. `allow-popups` (plus -to-escape-sandbox) is granted so
 * a genuine click still opens the advertiser in a new tab, which is how the unit
 * earns.
 *
 * Two further wins fall out of the isolation:
 *   - `atOptions` is per-window now, so units no longer collide and more than
 *     one per page is safe.
 *   - document.write happens inside the frame, so the tag can be lazy-loaded
 *     without any risk of wiping the page.
 */
import site from '@/config/site.json';

interface Props {
  /** Where this unit sits, e.g. "article-end". Rendered as a data attribute. */
  placement: string;
  class?: string;
}

const { placement, class: className = '' } = Astro.props;

const ads = site.ads;

/*
 * The key lands in both a URL path and a script body, so it is constrained to
 * the shape the network issues rather than trusted verbatim. A typo in config
 * becomes a missing ad, never an injection.
 */
const key = /^[A-Za-z0-9]+$/.test(ads?.key ?? '') ? ads.key : '';
const enabled = Boolean(ads?.enabled && key);

const width = Number(ads.width);
const height = Number(ads.height);

/*
 * The ad's own little document. `<\/script>` is escaped so the closing tag of
 * the string cannot terminate this component's own script block.
 */
const adDocument = `<!doctype html><html><head><meta charset="utf-8"><style>html,body{margin:0;padding:0;overflow:hidden;background:transparent}</style></head><body><script>atOptions={'key':'${key}','format':'iframe','height':${height},'width':${width},'params':{}};<\/script><script src="https://www.highrevenueformat.com/${key}/invoke.js"><\/script></body></html>`;
---

{
  enabled && (
    <aside
      class={`my-10 flex flex-col items-center ${className}`}
      data-ad-placement={placement}
      aria-label="Advertisement"
    >
      {/*
        Labelled because a reader is entitled to know which part of a health
        page is paid placement and which is editorial. Several jurisdictions
        require it, and it is the difference between an ad and a disguised one.
      */}
      <span class="mb-1.5 text-[11px] font-medium tracking-wide text-[var(--text-muted)] uppercase">
        Advertisement
      </span>

      {/*
        The wrapper absorbs the overflow, not the page: the unit is a fixed
        468px, wider than a phone, and body is overflow-x-hidden — without this
        the ad would be clipped rather than scrollable. Height is reserved so
        the frame cannot shift content and cost CLS.
      */}
      <div class="max-w-full overflow-x-auto" style={`min-height:${height}px;min-width:0`}>
        <iframe
          srcdoc={adDocument}
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
          width={width}
          height={height}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          scrolling="no"
          title="Advertisement"
          style={`width:${width}px;height:${height}px;border:0;display:block`}
        />
      </div>
    </aside>
  )
}
